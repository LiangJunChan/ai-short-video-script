# MiniMax API
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_API_BASE=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-M2

# Volcano Engine API (火山引擎)
VOLCANO_API_KEY=your_volcano_api_key_here
VOLCANO_API_BASE=https://ark.cn-beijing.volces.com
VOLCANO_MODEL=Doubao-Seed-2.0-lite

# LLM Provider: minimax / volcano / agnes
LLM_PROVIDER=agnes

# Agnes AI Generation Configuration
AGNES_API_KEY=your_agnes_api_key_here
AGNES_API_BASE=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0
AGNES_LLM_MODEL=agnes-2.0-flash

# Feature Flags
# 注册功能开关：true 开启，false 关闭（默认开启）
SIGN_UP=true

# 方式一：QQ邮箱（推荐，国内最稳定）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USER=你的QQ号@qq.com
# SMTP_PASS=你的QQ邮箱授权码    # 不是登录密码！
# EMAIL_FROM=AI短视频脚本平台 <你的QQ号@qq.com>

# 方式二：163邮箱（使用 465 SSL 端口）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=ljun000@163.com
SMTP_PASS=UQhWP3AJ3ZeRx4QC
